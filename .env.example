PORT=3001

# Optional. If unset, the app falls back to a local SQLite file at
# server/data/dashboard.db (no external account needed, e.g. for local dev).
# Set both to point at a free Turso database for production/Vercel, where
# there's no persistent local disk to fall back to.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
